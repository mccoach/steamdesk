# ============================================================
# m3u8Downloader .gitignore
# Python 桌面工具项目
#
# 原则：
# 1. 忽略本地环境、缓存、构建产物和用户运行数据。
# 2. 保留源码、测试、项目文档和正式构建配置。
# 3. 不按扩展名全局忽略数据库、压缩包、媒体和二进制资源。
#
# 以 / 开头的规则仅匹配项目根目录。
# 目录名规则没有开头 / 时，可匹配任意层级。
# ============================================================


# ============================================================
# 1. Python 编译缓存
# ============================================================

__pycache__/
*.py[cod]
*$py.class

# 不全局忽略 *.pyd、*.dll、*.so：
# 虚拟环境中的扩展由环境目录规则覆盖。
# 项目正式二进制扩展或测试资源仍可提交。


# ============================================================
# 2. Python 虚拟环境
# ============================================================

/.venv/
/.venv*/
/.venv-*/
/.venv_*/
/venv/
/env/
/ENV/
/virtualenv/
/.conda/

__pypackages__/

# 保留 .python-version：
# 它可以用于共享项目要求的 Python 版本。
# 如其中记录的是纯本机设置，可自行添加：
# /.python-version


# ============================================================
# 3. Python 构建与打包产物
# ============================================================

/build/
/dist/
/develop-eggs/
/eggs/
/.eggs/
/sdist/
/wheels/
/share/python-wheels/
/pip-wheel-metadata/

*.egg-info/
*.egg
.installed.cfg

# 保留：
# requirements.txt、pyproject.toml、各类依赖锁文件
# MANIFEST、MANIFEST.in
#
# 不默认忽略 /parts/、/var/：
# 它们可能是项目正式数据目录。


# ============================================================
# 4. PyInstaller 专用临时目录
# ============================================================

/.pack-build/
/.pack-spec/

# 常规 PyInstaller 产物已由 /build/、/dist/ 覆盖。
#
# 不全局忽略：
# *.spec、*.manifest、*.toc、*.pkg、*.pyz、*.pyzw
#
# 特别保留根目录 m3u8Downloader.spec：
# 它属于可复现构建配置，而不是可随意丢弃的产物。


# ============================================================
# 5. 测试与覆盖率产物
# ============================================================

.pytest_cache/
.hypothesis/
.tox/
.nox/

.coverage
.coverage.*

/htmlcov/
/coverage.xml
/coverage.json
/junit.xml
/test-results/
/tests/results/

# tests/results 按生成的测试结果目录处理。
# 如果实际存放正式测试样本，请删除该规则。
#
# 保留 tests/ 下的测试源码、固定样本与预期结果文件。


# ============================================================
# 6. 静态检查与类型检查缓存
# ============================================================

.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.pyright/
.dmypy.json
dmypy.json

/.cache/


# ============================================================
# 7. 本地 IDE / 编辑器配置
# ============================================================

/.vscode/
/.idea/
/.vim/

*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates

# .vscode 下的 launch.json、settings.json 当前按本地配置处理。
# 如果需要共享调试配置，请删除 /.vscode/ 规则，
# 再针对本地专用文件单独设置忽略规则。
#
# 不全局忽略 *.sln、*.njsproj：
# 它们可能是正式工程配置。


# ============================================================
# 8. 编辑器临时文件
# ============================================================

*.swp
*.swo
*~
.#*
~$*


# ============================================================
# 9. 操作系统生成文件
# ============================================================

.DS_Store
.AppleDouble
.LSOverride
._*

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/


# ============================================================
# 10. 日志与运行临时文件
# ============================================================

/logs/
/log/
/tmp/
/temp/

*.log
*.pid
*.pid.lock

pip-log.txt
pip-delete-this-directory.txt

# 不全局忽略 *.out、*.err、*.trace、*.tmp、*.temp：
# 它们可能是正式测试样本、预期输出或诊断资源。
# 程序生成的临时文件优先放入上面的专用目录。


# ============================================================
# 11. 本地环境变量与私密配置
# ============================================================

.env
.env.*

!.env.example
!.env.sample
!.env.template

/.secrets/
/secrets.local.json
/credentials.local.json
/token.local.json

# 不全局忽略 *.env、*.local、*.secret、*.pem、*.key：
# 避免误伤项目模板、正式资源或加密测试样本。
#
# 其他私密文件应按实际路径追加规则。
# .gitignore 不是凭据泄露防护工具，
# 提交前仍需检查配置模板、源码与文档是否包含敏感信息。


# ============================================================
# 12. m3u8Downloader 本地应用配置
# ============================================================

/m3u8downloader_config.json
/user_prefs.json

# 上述配置当前按用户本地运行数据处理：
# 可能含本机路径、下载地址、请求头和用户偏好。
#
# 如 m3u8downloader_config.json 是程序必需的公共默认配置，
# 请移除其忽略规则，确保内容脱敏后再提交。
#
# 可共享的示例配置默认允许提交，例如：
# m3u8downloader_config.example.json
# user_prefs.example.json


# ============================================================
# 13. AI 修改备份与本地历史归档
# ============================================================

# 任意层级的 AI 自动修改备份。
AI文件修改备份/

# 当前根目录中的历史归档。
/99_归档/

# 根目录的本地备份目录。
/backup/
/backups/

# 不全局忽略 *.bak、*.backup、*.orig、*.old、*.rej：
# 避免误伤正式恢复样本、补丁测试数据或历史资料。
#
# 如果以后需要提交 99_归档 中的其他文档，
# 删除 /99_归档/ 规则即可；
# AI文件修改备份/ 仍会继续被忽略。


# ============================================================
# 14. 下载、分片与任务输出目录
# ============================================================

/downloads/
/download_output/
/segments/

# 以上为预留的本地运行输出目录。
# 如果程序使用其他目录，请按实际路径补充。
# 如果其中某个目录存放正式项目资源，请删除对应规则。
#
# 不全局忽略：
# *.m3u8、*.ts、*.m4s、*.mp4、*.mkv、*.aac、*.key
#
# 原因：
# - *.ts 也可能是 TypeScript 源码。
# - 媒体、播放列表和密钥文件也可能是合法测试样本。


# ============================================================
# 15. 未完成的下载文件
# ============================================================

*.part
*.crdownload

# *.part 按未完成下载文件处理。
# 如果需要提交同扩展名的正式测试样本，
# 请在确认路径后添加精确的例外规则。


# ============================================================
# 16. Notebook 缓存
# ============================================================

.ipynb_checkpoints/


# ============================================================
# 17. 数据库、压缩包与二进制资源
# ============================================================

# 不设置以下全局忽略规则：
#
# 数据库：
# *.db、*.sqlite、*.sqlite3 及其附属文件
#
# 压缩包：
# *.zip、*.7z、*.rar、*.tar、*.tar.gz、*.tgz、*.gz
#
# 安装包与二进制：
# *.exe、*.msi、*.dmg、*.app、*.AppImage、*.pyd、*.dll
#
# 当前生成的发布文件已由 /dist/ 覆盖；
# 构建文件、备份和运行输出由相应目录规则覆盖。
#
# 新增本地数据库或其他生成文件时，
# 优先按具体路径设置忽略规则，避免误伤正式资源。


# ============================================================
# 18. 默认保留的项目文件
# ============================================================

# 以下内容不需要额外添加 ! 规则，默认可被 Git 跟踪：
#
# - main.py
# - app_config.py
# - downloader.py
# - parser.py
# - merger.py
# - task_engine.py
# - ui.py
# - tests/ 下的测试源码与正式测试资源
# - requirements.txt
# - m3u8Downloader.spec
# - 开发指导书.md
# - AI编程最高原则与最终态执行协议.md
# - Zipatch_V3_修改包协议规范.md
# - assets/ 下的正式图标、图片等资源
#
# 注意：
# 被整个目录忽略后，仅添加 !*.py 或 !assets/*.png
# 不能重新包含该目录中的文件。
